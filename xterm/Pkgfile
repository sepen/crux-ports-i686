# Description: Termulator emulator for X Windows
# URL: https://invisible-island.net/xterm/xterm.html
# Maintainer: Jose Beneyto, sepen at crux dot nu
# Depends on: xorg-font-alias xorg-font-misc-misc xorg-libxaw

name=xterm
version=401
release=1
source=(https://invisible-mirror.net/archives/$name/$name-$version.tgz)

build() {
    cd $name-$version

    ./configure \
        --prefix=/usr \
        --with-app-defaults=/usr/share/X11/app-defaults/ \
        --disable-nls \
        --enable-256-color \
        --enable-wide-chars

    make
    make install DESTDIR=$PKG

    install -d $PKG/usr/share/applications
    install -m 0644 xterm.desktop $PKG/usr/share/applications
}
